[PROJECT]
    TARGET_DIR = .\run
    Version = 2.0
    Project.xpj
    AUX.FILE = readme.md
    AUX.FILE = e-invoice-factory-usage-guide.md

[project.xpj]
    create-invoices-dto.exe
    create-invoices.exe

[create-invoices-dto.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           =
    RC_COMPILE           = arc
    RC_FLAGS             =
    TARGET_DIR           = .\
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    DEPENDS_ON           = $(ASSETS_PATH)\e-invoice-factory
    // $START-AUTODEPEND
    create-invoices-dto.obj
    // $STOP-AUTODEPEND
    create-invoices-dto.prg


    [create-invoices.exe]
    COMPILE              = xpp
    COMPILE_FLAGS        = /wi /wl /wu /q /w
    DEBUG                = yes
    GUI                  = no
    LINKER               = alink
    LINK_FLAGS           =
    RC_COMPILE           = arc
    RC_FLAGS             =
    TARGET_DIR           = .\
    INTERMEDIATE_DEBUG   = .debug
    INTERMEDIATE_RELEASE = .release
    DEPENDS_ON           = $(ASSETS_PATH)\e-invoice-factory
    // $START-AUTODEPEND
    create-invoices.obj
    // $STOP-AUTODEPEND
    create-invoices.prg










